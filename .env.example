# ---- LLM provider: "azure" (Azure OpenAI) or "openai" (api.openai.com) ----
LLM_PROVIDER=azure

# Azure OpenAI (used when LLM_PROVIDER=azure). CHAT_MODEL / REWRITE_MODEL are deployment names.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# OpenAI (used when LLM_PROVIDER=openai). CHAT_MODEL / REWRITE_MODEL are model names, e.g. gpt-4o-mini.
OPENAI_API_KEY=

# Answer model. For a reasoning model (gpt-5.x / o-series) also set CHAT_REASONING_EFFORT=low.
CHAT_MODEL=gpt-4o
CHAT_REASONING_EFFORT=
# Router / query-rewriter model (small and fast is fine).
REWRITE_MODEL=gpt-4o
REWRITE_REASONING_EFFORT=

# Protects /api/admin/* (refresh, unanswered log, leads)
ADMIN_TOKEN=change-me
# Shown in the crawler User-Agent so site owners can reach us
CRAWLER_CONTACT=you@example.com
# Where the KB snapshot + SQLite live
DATA_DIR=data
